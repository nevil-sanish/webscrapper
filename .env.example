GROQ_API_KEY=
# Primary web search provider
TAVILY_API_KEY=
# Optional backup provider
SERP_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
REPORT_EMAIL=

# Google Calendar Integration
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
# Alternative to the three OAuth values above: the service account key JSON on one line, in single quotes
GOOGLE_SERVICE_ACCOUNT_KEY=

# Local monthly attempt limits (conservative defaults; separate from provider account usage)
TAVILY_MONTHLY_LIMIT=900
SERP_MONTHLY_LIMIT=80
SEARCH_QUERIES_PER_RUN=20
SEARCH_PAGES_PER_RUN=80
